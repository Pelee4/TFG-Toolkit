  generatedScript: "```csharp\nusing UnityEngine;\nusing UnityEngine.InputSystem;\n\npublic
    class AtaqueCorpusCaesCuerpo : MonoBehaviour\n{\n    private void Update()\n   
    {\n        if (Input.GetKeyDown(KeyCode.LeftControl))\n        {\n           
    Collider frontalCollider = Instantiate(FrontalDamageCollider, transform.position,
    Quaternion.identity);\n            Destroy(frontalCollider.gameObject, 0.3f);\n       
    }\n    }\n\n    [System.Serializable]\n    private class FrontalDamageCollider
    : MonoBehaviour\n    {\n        public void OnEnable()\n        {\n           
    Collider2D collider = GetComponent\\u003cCollider2D\\u003e();\n            if
    (collider != null)\n            {\n                Rigidbody2D rb = GameObject.FindObjectOfType\\u003cRigidbody2D\\u003e();\n               
    if (rb != null)\n                    rb.AddForce(transform.forward * 5, ForceMode2D.Impulse);\n               
    Destroy(this);\n            }\n        }\n    }\n\n    private void OnEnable()\n   
    {\n        InputSystem.Enablew();\n    }\n}\n```"
